{
  "name": "__PLUGIN_ID__",
  "version": "0.1.0",
  "type": "module",
  "dlient": {
    "id": "__PLUGIN_ID__",
    "name": {
      "default": "__PLUGIN_NAME__",
      "zh-CN": "__PLUGIN_NAME__",
      "en-US": "__PLUGIN_NAME__"
    },
    "description": {
      "default": "A dlient plugin created from template",
      "zh-CN": "由模板创建的 dlient 插件",
      "en-US": "A dlient plugin created from template"
    },
    "type": "app",
    "source": "dev",
    "workerMode": "shared",
    "icon": "assets/icon.svg",
    "search_api": "",
    "platforms": [
      "win32.x64",
      "win32.arm64",
      "darwin.x64",
      "darwin.arm64",
      "linux.x64",
      "linux.arm64"
    ],
    "permissions": [
      "app.crypt",
      "app.data",
      "app.event",
      "app.getPath",
      "app.notify",
      "dialog.showOpenDialog",
      "dialog.showSaveDialog",
      "log",
      "permission.request",
      "plugin.invoke"
    ],
    "expose": {
      "__PLUGIN_ID__.greet": {
        "description": "示例方法：向插件 worker 发送问候，返回问候语字符串（无参数）",
        "access": "public",
        "paramsSchema": {
          "type": "array",
          "description": "参数（按位置）",
          "items": []
        }
      }
    },
    "dependencies": {}
  },
  "scripts": {
    "build": "node script/build-clean.mjs && npm run build:ui && npm run build:worker",
    "build:ui": "vite build",
    "build:worker": "node script/build-worker.mjs",
    "pack": "npm run build && node script/make-dlient.mjs",
    "dev:watch": "vite build --watch",
    "dev:watch:worker": "node script/build-worker.mjs --watch",
    "dev": "concurrently -k \"npm:dev:watch\" \"npm:dev:watch:worker\""
  },
  "devDependencies": {
    "@dlient-open/api-bridge": "^0.1.0",
    "@dlient-open/i18n": "^0.1.0",
    "@dlient-open/plugin-sdk": "^0.1.0",
    "@dlient-open/ui": "^0.1.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "concurrently": "^9.1.0"
  }
}
