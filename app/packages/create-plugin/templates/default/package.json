{
  "name": "__PLUGIN_ID__",
  "version": "0.1.0",
  "author": "Dlient",
  "keywords": [
    "dlient-open-plugin",
    "dlient",
    "app"
  ],
  "type": "module",
  "files": [
    "dist",
    "assets",
    "script",
    "*.dlient"
  ],
  "dlient": {
    "id": "__PLUGIN_ID__",
    "name": {
      "default": "__PLUGIN_NAME__",
      "zh-CN": "__PLUGIN_NAME__",
      "en-US": "__PLUGIN_NAME__"
    },
    "description": {
      "default": "A dlient plugin created from template",
      "zh-CN": "由模板创建的 dlient 插件",
      "en-US": "A dlient plugin created from template"
    },
    "type": "app",
    "source": "dev",
    "icon": "assets/icon.svg",
    "search_api": "",
    "platforms": [
      "win32.x64",
      "win32.arm64",
      "darwin.x64",
      "darwin.arm64",
      "linux.x64",
      "linux.arm64"
    ],
    "permissions": [
      "log"
    ],
    "dependencies": {}
  },
  "scripts": {
    "build": "node script/build-clean.mjs && npm run typecheck && npm run build:ui",
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build",
    "pack": "npm run build && node script/make-dlient.mjs",
    "prepublishOnly": "npm run pack",
    "dev:watch": "vite build --watch",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "@dlient-open/api-bridge": "^0.1.0",
    "@dlient-open/i18n": "^0.1.0",
    "@dlient-open/plugin-sdk": "^0.1.0",
    "@dlient-open/ui": "^0.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
