{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@dlient-open/ui": ["./src/index.ts"],
      "@dlient-open/ui/*": ["./src/*"]
    }
  },
  "include": ["src", "host-bridge.d.ts", "systemjs.d.ts", "css.d.ts"],
  "exclude": ["src/**/*.d.ts"]
}
