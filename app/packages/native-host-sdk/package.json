{
    "name": "@dlient-open/native-host-sdk",
    "version": "0.1.1",
    "author": "Dlient",
    "description": "原生模块按用户侧安装：native-host 子进程协议/服务注册表/客户端（纯 Node，零 Electron 依赖）",
    "private": false,
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./example": {
            "types": "./dist/example-host.d.ts",
            "import": "./dist/example-host.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.json",
        "selftest": "node scripts/selftest.mjs"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.4.0",
        "vite": "^5.1.6"
    }
}
