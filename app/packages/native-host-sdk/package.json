{
    "name":  "@dlient-open/native-host-sdk",
    "version":  "0.3.2",
    "description":  "原生模块按用户侧安装：native-host 子进程协议/服务注册表/客户端（纯 Node，零 Electron 依赖）",
    "private":  false,
    "type":  "module",
    "publishConfig":  {
                          "access":  "public"
                      },
    "main":  "./src/index.ts",
    "types":  "./src/index.ts",
    "exports":  {
                    ".":  "./src/index.ts",
                    "./example":  "./src/example-host.ts"
                },
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "build":  "vite build \u0026\u0026 tsc -p tsconfig.json",
                    "selftest":  "node scripts/selftest.mjs"
                },
    "devDependencies":  {
                            "@types/node":  "^20.0.0",
                            "typescript":  "^5.4.0",
                            "vite":  "^5.1.6"
                        }
}