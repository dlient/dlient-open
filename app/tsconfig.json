{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@dlient-open/core": ["./packages/core/src/index.ts"],
      "@dlient-open/core/*": ["./packages/core/src/*"],
      "@dlient-open/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@dlient-open/ui": ["./packages/ui/src/index.ts"],
      "@dlient-open/i18n": ["./packages/i18n/src/index.ts"],
      "@dlient-open/api-bridge": ["./packages/api-bridge/src/index.ts"],
      "@dlient-open/api-types": ["./packages/api-types/src/index.ts"],
      "@dlient-open/native-host-sdk": ["./packages/native-host-sdk/src/index.ts"]
    }
  },
  "include": ["src", "packages/ui/systemjs.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
